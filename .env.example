# Public Supabase configuration. These values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only database configuration. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only RapidAPI OTAPI configuration.
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=your-otapi-rapidapi-host

# Development-only deterministic provider payloads. Ignored in production.
OTAPI_DEV_MOCK_MODE=false

# Comma-separated exact chrome-extension:// origins permitted to call /api/extension/*.
# Keep empty until the privately distributed extension ID is known.
CHROME_EXTENSION_ORIGINS=chrome-extension://your-extension-id
