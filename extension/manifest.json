{
  "manifest_version": 3,
  "name": "BridgeCart Purchase Assistant",
  "version": "0.1.0",
  "description": "Admin-only helper for preparing exact 1688 cart items.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.1688.com/*", "https://1688.com/*", "http://localhost:3000/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.1688.com/*", "https://1688.com/*"],
      "js": ["adapters/1688/adapter.js", "content.js"]
    }
  ]
}
