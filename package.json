{
  "name": "cross-border-sourcing-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:notifications": "node --test tests/wallet/notifications-dashboard-static.test.mjs",
    "test:auth": "node --test tests/auth/authorization.test.mjs",
    "test:estimates": "node --test tests/estimates/*.test.mjs",
    "test:products": "node --test tests/products/*.test.mjs",
    "test:visual:dashboard": "playwright test tests/visual/client/dashboard.visual.spec.ts",
    "test:visual:orders": "playwright test tests/visual/client/orders.visual.spec.ts",
    "test:visual:new-order": "playwright test tests/visual/client/new-order.visual.spec.ts",
    "mobile:start": "npm --workspace @bridgecart/mobile run start",
    "mobile:typecheck": "npm --workspace @bridgecart/mobile run typecheck",
    "mobile:lint": "npm --workspace @bridgecart/mobile run lint",
    "mobile:test": "npm --workspace @bridgecart/mobile run test",
    "mobile:doctor": "npm --workspace @bridgecart/mobile run doctor"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^0.468.0",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
